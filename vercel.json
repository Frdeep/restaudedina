{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "node scripts/export.mjs",
  "outputDirectory": "artifacts/site",
  "installCommand": "node --version",
  "functions": {
    "api/*.mjs": {
      "includeFiles": "data/*.json"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; media-src 'self'; frame-src https://www.facebook.com https://www.instagram.com https://maps.google.com https://www.google.com; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        }
      ]
    }
  ]
}
